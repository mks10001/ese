[zz]
[! 中文模式示例：组件状态、派生值、事件绑定、路由、遍历键 !]
[ese.bd
  [! ===== 全局状态 ===== !]
  [# 访问语 = "欢迎来到 ese 站点" #]

  [> 全局 :
    [$ 访问语 = "欢迎回来！" $]
  >]

  [! ===== 组件 ===== !]
  [+ 组件 计数器
    属性 起始 数字 = 0
    [# 当前 = 起始 #]
    [$ 派生 双倍 = 当前 * 2 $]
    [+ 居中
      [- 当前计数：{当前}（双倍：{双倍}） -]
      [> 加一 <] 调用 加一
      [> 归零 <] 调用 归零
    +]
    [> 加一 :
      [$ 当前 = 当前 + 1 $]
    >]
    [> 归零 :
      [$ 当前 = 0 $]
    >]
  +]

  [! ===== 页面 ===== !]
  [/ 页面 home
    [- {访问语} -]
    [< 计数器 起始=10 >]

    [# 待办 = ["买菜", "写代码"] #]
    [~ 遍历 待办 为 项 键={项}
      [- {项} -]
    ~]

    [c. 去关于页 .c] 跳转 about
  /]

  [/ 页面 about
    [- 关于本页 -]
    [---]
    [c. 回首页 .c] 跳转 home
  /]
]
