[zz]
[! ese 语言演示：备忘录。覆盖双向绑定、列表增删、派生值、分支、遍历、组件与路由。 !]
[ese.bd
  [! ===== 全局状态 ===== !]
  [# 访问语 = "你好，这是一份备忘录" #]
  [> 全局 :
    [$ 访问语 = "欢迎回来，这是你的备忘录" $]
  >]

  [! ===== 组件：统计条 ===== !]
  [+ 组件 统计条
    属性 数字 数字 = 0
    属性 单位 文字 = "条记录"
    [+ 样式 = "背景: #f2f6ff; 内距: 8; 圆角: 8; 外距: 10 0"
      [- 共 {数字} {单位} -]
    +]
  +]

  [! ===== 页面：home ===== !]
  [/ 页面 home
    [# 条目 = ["用 ese 写第一行代码", "把它转译成真正的网页", "给仓库点一个星"] #]
    [# 草稿 = "" #]
    [$ 派生 总数 = 长度(条目) $]

    [+ 样式 = "宽度: 560; 外距: 0 auto"
      [- ese 备忘录 -]
      [- {访问语} -]
      [< 统计条 数字={总数} >]

      [= 草稿 提示="想记点什么…" =]
      [> 记下这条 <] 调用 添加

      [---]

      [? 总数 > 0
        [~ 遍历 条目 为 项
          [+ 样式 = "背景: #fcfdff; 边框: 1px solid #e1e7ef; 圆角: 8; 内距: 8; 外距: 6 0"
            [- {项} -]
            [> 删掉这条 <] 调用 删除(项)
          +]
        ~]
      [??
        [- 列表空空的，添加第一条吧 -]
      ??]
      ?]

      [c. 关于这门语言 .c] 跳转 about
    +]

    [> 添加 :
      [? 长度(草稿) > 0
        [$ 条目 = 加入(条目, 草稿) $]
        [$ 草稿 = "" $]
      ?]
    >]

    [! 删除：重建列表，滤掉目标值（同名条目会一并移除） !]
    [> 删除(条) :
      [# 新表 = [] #]
      [~ 遍历 条目 为 一条
        [? 一条 != 条
          [$ 新表 = 加入(新表, 一条) $]
        ?]
      ~]
      [$ 条目 = 新表 $]
    >]
  /]

  [! ===== 页面：about ===== !]
  [/ 页面 about
    [+ 样式 = "宽度: 560; 外距: 0 auto"
      [- 关于这一页 -]
      [---]
      [- 这一页由 ese 语言写成：一门用对称括号书写的极简全栈语言。你看到的每个按钮、每行文字，都来自 ese.bd 这一个文件，经 ese build 转译而成。 -]
      [- 空着试试：什么都不输入，点「记下这条」不会添加空条目 —— 那是一个 [? ?] 分支在守门。 -]
      [c. 回到备忘录 .c] 跳转 home
    +]
  /]
]
