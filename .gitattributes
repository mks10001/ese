# 统一换行符：仓库内一律 LF，检出时由 Git 按平台处理
* text=auto eol=lf

# 规范与代码源文件强制 LF（避免 Windows 下全文件 diff）
*.md    text eol=lf
*.bd    text eol=lf
*.json  text eol=lf
*.ebnf  text eol=lf
*.html  text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# 二进制
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
